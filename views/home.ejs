<%- include('partials/header', { title, bodyClass: 'home-page' }) %>

<section class="hero">
  <div class="hero-media" aria-hidden="true">
    <img src="/assets/app-shell.png" alt="">
  </div>
  <div class="hero-shade"></div>
  <div class="hero-content page-width">
    <div class="hero-copy">
      <span class="eyebrow"><span class="status-dot"></span> Built for Mortal Online 2</span>
      <h1>Mortal Nexus</h1>
      <p class="hero-lead">Live maps, exact crafting tools, decoded loot data, spell planning, macros, and field guides in one focused desktop companion.</p>
      <div class="hero-actions">
        <a class="button button-primary button-large" href="#pricing"><i data-lucide="key-round"></i>Get lifetime access</a>
        <a class="button button-glass button-large" href="#inside"><i data-lucide="play"></i>See the app</a>
      </div>
      <div class="hero-proof" aria-label="Product highlights">
        <span><i data-lucide="badge-check"></i>One-time purchase</span>
        <span><i data-lucide="refresh-cw"></i>Future updates included</span>
        <span><i data-lucide="monitor-down"></i>Windows desktop app</span>
      </div>
    </div>
  </div>
  <a class="hero-next" href="#features" aria-label="Explore Mortal Nexus features"><span>Explore the Nexus</span><i data-lucide="arrow-down"></i></a>
</section>

<section class="section page-width" id="features">
  <div class="section-heading capability-heading">
    <p class="section-kicker">Not another pile of browser tabs</p>
    <h2>The information you need,<br>in the order you need it.</h2>
  </div>

  <div class="capability-list">
    <article class="capability-row">
      <span class="capability-number">01</span>
      <div class="capability-copy"><p class="capability-label">Map</p><h3>Find it without clearing the map.</h3><p>Search results pulse in place while towns, terrain, and nearby markers stay visible. Switch between Sarducaa and two Myrland map styles without rebuilding your filters.</p><div class="capability-tags"><span>Search pulse</span><span>POI images</span><span>Saved filters</span></div></div>
      <figure class="capability-media"><img src="/assets/app-myrland.png" alt="Mortal Nexus Myrland map with points of interest" loading="lazy"></figure>
    </article>
    <article class="capability-row">
      <span class="capability-number">02</span>
      <div class="capability-copy"><p class="capability-label">Craft</p><h3>Know the result before using the materials.</h3><p>Build equipment, compare materials, reverse-search recipes, and calculate extraction, refining, alchemy, cooking, and construction from one workspace.</p><div class="capability-tags"><span>Exact totals</span><span>Comparisons</span><span>Reverse search</span></div></div>
      <figure class="capability-media"><img src="/assets/app-crafting.png" alt="Mortal Nexus crafting calculator" loading="lazy"></figure>
    </article>
    <article class="capability-row">
      <span class="capability-number">03</span>
      <div class="capability-copy"><p class="capability-label">Hunt</p><h3>Check the target, then decide if it is worth the trip.</h3><p>Inspect creature stats, drop chances, quantities, butcher yields, containers, and resource sources without digging through disconnected sheets.</p><div class="capability-tags"><span>Combat profiles</span><span>Loot tables</span><span>Butchery yields</span></div></div>
      <figure class="capability-media"><img src="/assets/app-creatures.png" alt="Mortal Nexus creature codex" loading="lazy"></figure>
    </article>
    <article class="capability-row">
      <span class="capability-number">04</span>
      <div class="capability-copy"><p class="capability-label">Prepare</p><h3>Set the loadout and keep moving.</h3><p>Total spell reagents, search focused guides, build a character, or run controlled training tools with one visible master hotkey switch.</p><div class="capability-tags"><span>Spell tally</span><span>Character builds</span><span>Background hotkeys</span></div></div>
      <figure class="capability-media"><img src="/assets/app-spells.png" alt="Mortal Nexus spell planner" loading="lazy"></figure>
    </article>
  </div>
</section>

<section class="section product-stage" id="inside">
  <div class="page-width">
    <div class="section-heading centered-heading">
      <span class="eyebrow">Inside Mortal Nexus</span>
      <h2>Take a look through the app.</h2>
      <p>The tour advances automatically. Choose any labeled view or use the arrows to browse at your own pace.</p>
    </div>
    <div class="product-tabs" data-gallery>
      <div class="gallery-status" aria-live="polite">
        <div><span data-gallery-count>01 / 12</span><strong data-gallery-title>Sarducaa live map</strong></div>
        <button class="button button-quiet gallery-toggle" type="button" data-gallery-toggle aria-label="Pause automatic screenshot tour"><i data-lucide="pause"></i><span>Pause tour</span></button>
      </div>
      <div class="gallery-tabs" role="tablist" aria-label="Application screenshots">
        <button class="gallery-tab active" type="button" role="tab" aria-selected="true" data-image="/assets/app-shell.png" data-alt="Mortal Nexus Sarducaa live map" data-title="Sarducaa live map"><i data-lucide="sun"></i>Sarducaa</button>
        <button class="gallery-tab" type="button" role="tab" aria-selected="false" data-image="/assets/app-myrland.png" data-alt="Mortal Nexus Myrland live map" data-title="Myrland live map"><i data-lucide="mountain"></i>Myrland</button>
        <button class="gallery-tab" type="button" role="tab" aria-selected="false" data-image="/assets/app-myrland-alt.png" data-alt="Mortal Nexus alternate Myrland map" data-title="Myrland alternate map"><i data-lucide="map-pinned"></i>Alt map</button>
        <button class="gallery-tab" type="button" role="tab" aria-selected="false" data-image="/assets/app-reference.png" data-alt="Mortal Nexus reference archive" data-title="Reference archive"><i data-lucide="library"></i>Reference</button>
        <button class="gallery-tab" type="button" role="tab" aria-selected="false" data-image="/assets/app-loot.png" data-alt="Mortal Nexus creature loot database" data-title="Loot database"><i data-lucide="skull"></i>Loot</button>
        <button class="gallery-tab" type="button" role="tab" aria-selected="false" data-image="/assets/app-spells.png" data-alt="Mortal Nexus spell planner" data-title="Spell planner"><i data-lucide="sparkles"></i>Spells</button>
        <button class="gallery-tab" type="button" role="tab" aria-selected="false" data-image="/assets/app-character.png" data-alt="Mortal Nexus character builder" data-title="Character builder"><i data-lucide="user-round-cog"></i>Character</button>
        <button class="gallery-tab" type="button" role="tab" aria-selected="false" data-image="/assets/app-crafting.png" data-alt="Mortal Nexus crafting calculator" data-title="Crafting calculator"><i data-lucide="hammer"></i>Crafting</button>
        <button class="gallery-tab" type="button" role="tab" aria-selected="false" data-image="/assets/app-creatures.png" data-alt="Mortal Nexus creature codex" data-title="Creature codex"><i data-lucide="paw-print"></i>Creatures</button>
        <button class="gallery-tab" type="button" role="tab" aria-selected="false" data-image="/assets/app-macros.png" data-alt="Mortal Nexus macro controls" data-title="Macro controls"><i data-lucide="zap"></i>Macros</button>
        <button class="gallery-tab" type="button" role="tab" aria-selected="false" data-image="/assets/app-guides.png" data-alt="Mortal Nexus guides library" data-title="Guide library"><i data-lucide="book-open"></i>Guides</button>
        <button class="gallery-tab" type="button" role="tab" aria-selected="false" data-image="/assets/app-settings.png" data-alt="Mortal Nexus settings and commands" data-title="Settings and commands"><i data-lucide="settings"></i>Settings</button>
      </div>
      <div class="app-window">
        <div class="window-bar"><span></span><span></span><span></span><strong>Mortal Nexus</strong></div>
        <img data-gallery-image src="/assets/app-shell.png" alt="Mortal Nexus Sarducaa live map">
        <button class="gallery-arrow gallery-arrow-prev" type="button" data-gallery-prev aria-label="Previous screenshot"><i data-lucide="chevron-left"></i></button>
        <button class="gallery-arrow gallery-arrow-next" type="button" data-gallery-next aria-label="Next screenshot"><i data-lucide="chevron-right"></i></button>
        <div class="gallery-progress" aria-hidden="true"><span data-gallery-progress></span></div>
      </div>
    </div>
  </div>
</section>

<section class="section workflow-section">
  <div class="page-width workflow-grid">
    <div class="workflow-copy">
      <span class="eyebrow">Made to stay out of the way</span>
      <h2>Find the answer, then get back to Nave.</h2>
      <p>The interface is designed for quick scanning on your main display or a second screen. Search once, keep your filters, and move between maps and reference tools without opening another browser maze.</p>
      <a class="text-link" href="#pricing">View lifetime access <i data-lucide="arrow-right"></i></a>
    </div>
    <ol class="workflow-steps">
      <li><span>01</span><div><strong>Search</strong><p>Type a creature, drop, town, resource, spell, or material.</p></div></li>
      <li><span>02</span><div><strong>Inspect</strong><p>Read the relevant map card, calculation, table, or guide.</p></div></li>
      <li><span>03</span><div><strong>Act</strong><p>Use the location, route context, totals, or timing in game.</p></div></li>
    </ol>
  </div>
</section>

<section class="section pricing-section" id="pricing">
  <div class="page-width pricing-layout">
    <div class="pricing-copy">
      <span class="eyebrow">Simple access</span>
      <h2>Buy it once. Keep the Nexus.</h2>
      <p>No subscription and no feature tiers. Your purchase includes the Windows application, a personal license key, and all future Mortal Nexus updates.</p>
      <div class="secure-note"><i data-lucide="shield-check"></i><span><strong>Secure checkout</strong>Pay with Stripe or PayPal. After payment, your license is generated, saved to your account, and emailed to you.</span></div>
    </div>
    <div class="price-panel">
      <div class="price-top"><span>Lifetime license</span><strong><%= price %></strong><small>one-time payment</small></div>
      <ul class="included-list">
        <li><i data-lucide="check"></i>Live Myrland and Sarducaa maps</li>
        <li><i data-lucide="check"></i>Crafting and material calculators</li>
        <li><i data-lucide="check"></i>Loot, creature, spell, and guide databases</li>
        <li><i data-lucide="check"></i>Macros and second-screen tools</li>
        <li><i data-lucide="check"></i>All future updates</li>
      </ul>
      <% if (user) { %>
        <div class="checkout-options">
          <form method="post" action="/checkout">
            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
            <button class="button button-primary button-large button-full" type="submit"><i data-lucide="credit-card"></i>Pay with card or wallet</button>
          </form>
          <% if (paypalEnabled) { %>
            <div class="checkout-divider"><span>or</span></div>
            <a class="button button-paypal button-large button-full" href="/checkout/paypal"><strong>PayPal</strong></a>
          <% } %>
        </div>
      <% } else { %>
        <a class="button button-primary button-large button-full" href="/register?next=/buy"><i data-lucide="key-round"></i>Create account and purchase</a>
      <% } %>
      <div class="payment-methods"><span><i data-lucide="credit-card"></i>Cards</span><span><i data-lucide="smartphone"></i>Wallets</span><span><i data-lucide="badge-dollar-sign"></i>PayPal</span></div>
      <p class="microcopy">License keys are personal and may be hardware-bound by the application.</p>
    </div>
  </div>
</section>

<section class="section faq-section">
  <div class="page-width faq-layout">
    <div><span class="eyebrow">Before you buy</span><h2>Common questions.</h2><p>Need something else? The support page has direct contact and setup help.</p><a class="button button-quiet" href="/support">Open support</a></div>
    <div class="faq-list">
      <details><summary>How do I receive my key?<i data-lucide="plus"></i></summary><p>After Stripe or PayPal confirms payment, the site generates your personal KeyAuth license, places it in your account, and emails it to your account address.</p></details>
      <details><summary>Are updates included?<i data-lucide="plus"></i></summary><p>Yes. Lifetime access includes future application updates and content added to Mortal Nexus.</p></details>
      <details><summary>What system does it support?<i data-lucide="plus"></i></summary><p>Mortal Nexus is a Windows desktop application. The current installer is always available from your account.</p></details>
      <details><summary>Is this an official Mortal Online 2 product?<i data-lucide="plus"></i></summary><p>No. Mortal Nexus is an independent community companion and is not affiliated with Star Vault.</p></details>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
