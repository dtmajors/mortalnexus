<%- include('partials/header', { title, bodyClass: 'content-page' }) %>
<section class="result-page page-width"><div class="result-mark error"><i data-lucide="triangle-alert"></i></div><span class="eyebrow">Error <%= status %></span><h1><%= status === 404 ? 'That path leads nowhere.' : status === 403 ? 'Premium access required.' : 'The request could not be completed.' %></h1><p><%= message %></p><div class="result-actions"><a class="button button-primary" href="<%= status === 403 ? '/#pricing' : '/' %>"><%= status === 403 ? 'Get Premium' : 'Return home' %></a><a class="button button-quiet" href="<%= status === 403 ? '/account' : '/support' %>"><%= status === 403 ? 'Open account' : 'Support' %></a></div></section>
<%- include('partials/footer') %>
