<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#07090e">
  <meta name="google-site-verification" content="8fDOPGgGskleNWBBtbS37OZikWrDQa5mG19kZqiSfjM">
  <meta name="description" content="<%= metaDescription %>">
  <meta name="robots" content="<%= robots %>">
  <link rel="canonical" href="<%= canonicalUrl %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Mortal Nexus">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:image" content="<%= ogImageUrl %>">
  <meta property="og:image:alt" content="Mortal Nexus companion application for Mortal Online 2">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= metaDescription %>">
  <meta name="twitter:image" content="<%= ogImageUrl %>">
  <title><%= title %></title>
  <link rel="icon" href="/assets/mortal-nexus-icon.png" type="image/png">
  <link rel="stylesheet" href="/styles.css?v=<%= encodeURIComponent(assetVersion) %>">
  <script src="/vendor/lucide.js" defer></script>
  <script src="/app.js?v=<%= encodeURIComponent(assetVersion) %>" defer></script>
  <% structuredData.forEach((entry) => { %><script type="application/ld+json" nonce="<%= cspNonce %>"><%- JSON.stringify(entry).replace(/</g, '\\u003c') %></script><% }) %>
</head>
<body class="<%= bodyClass || '' %>">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header" data-header>
    <div class="header-inner">
      <a class="brand" href="/" aria-label="Mortal Nexus home">
        <img src="/assets/mortal-nexus-icon.png" alt="" width="44" height="44">
        <span><strong>Mortal Nexus</strong><small>Mortal Online 2 companion</small></span>
      </a>
      <button class="nav-toggle icon-button" type="button" data-nav-toggle aria-label="Open navigation" aria-expanded="false"><i data-lucide="menu"></i></button>
      <nav class="main-nav" data-nav>
        <a href="/mortal-online-2-map">MO2 Map</a>
        <a href="/#features">Features</a>
        <a href="/#inside">Inside the app</a>
        <a href="/#pricing">Free &amp; Premium</a>
        <a href="/support">Support</a>
      </nav>
      <div class="header-actions">
        <% if (user) { %>
          <% if (user.role === 'admin') { %><a class="button button-quiet" href="/admin"><i data-lucide="shield"></i>Admin</a><% } %>
          <a class="button button-quiet" href="/account"><i data-lucide="user-round"></i>Account</a>
        <% } else { %>
          <a class="button button-quiet" href="/login">Sign in</a>
        <% } %>
        <a class="button button-primary header-buy" href="/download/latest"><i data-lucide="download"></i>Download Free</a>
      </div>
    </div>
  </header>
  <% if (notice) { %><div class="global-message success"><i data-lucide="check-circle-2"></i><%= notice %></div><% } %>
  <% if (error) { %><div class="global-message error"><i data-lucide="circle-alert"></i><%= error %></div><% } %>
  <main id="main">
