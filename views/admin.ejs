<%- include('partials/header', { title, bodyClass: 'account-page' }) %>
<section class="account-hero"><div class="page-width account-heading"><div><span class="eyebrow">Mortal Nexus administration</span><h1>Users and access</h1><p>Manage customer accounts, claimed keys, editor rights, purchases, and desktop sessions.</p></div><a class="button button-quiet" href="/account"><i data-lucide="user-round"></i>My account</a></div></section>
<main class="section compact-section page-width admin-page">
  <nav class="admin-tabs" aria-label="Admin sections"><a href="#users">Users</a><a href="#licenses">Licenses</a><a href="#sessions">App sessions</a><a href="#orders">Orders</a><a href="#activity">Activity</a></nav>
  <div class="metric-grid admin-metrics">
    <div><span>Accounts</span><strong><%= metrics.customers %></strong></div><div><span>Licenses</span><strong><%= metrics.licenses %></strong></div><div><span>Editors</span><strong><%= metrics.editors %></strong></div><div><span>Active app sessions</span><strong><%= metrics.active_sessions %></strong></div><div><span>Fulfilled revenue</span><strong><%= new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(metrics.revenue / 100) %></strong></div>
  </div>

  <section class="admin-section" id="users"><div class="section-heading mini-heading"><div><span class="eyebrow">Accounts</span><h2>Users and permissions</h2><p>Editor changes revoke current app sessions so the new permission is applied at the next sign-in.</p></div></div><div class="data-table-wrap"><table class="data-table admin-users-table"><thead><tr><th>User</th><th>License</th><th>Last activity</th><th>Site role</th><th>App rights</th><th>Session</th></tr></thead><tbody>
    <% users.forEach((customer) => { %><tr>
      <td><strong><%= customer.display_name %></strong><small><%= customer.email %></small><small><%= customer.discord_id ? `Discord: ${customer.discord_username || customer.discord_id}` : 'Email account' %></small></td>
      <td><strong><%= customer.license_count %> key<%= customer.license_count === 1 ? '' : 's' %></strong><small><%= customer.active_sessions %> active session<%= customer.active_sessions === 1 ? '' : 's' %></small></td>
      <td><%= customer.last_app_seen ? new Date(customer.last_app_seen).toLocaleString() : 'Never opened app' %><small>Site: <%= customer.last_login_at ? new Date(customer.last_login_at).toLocaleDateString() : 'Never' %></small></td>
      <td><form class="inline-admin-form" method="post" action="/admin/users/<%= customer.id %>/role"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><select name="role" aria-label="Role for <%= customer.display_name %>"><option value="customer" <%= customer.role === 'customer' ? 'selected' : '' %>>Customer</option><option value="admin" <%= customer.role === 'admin' ? 'selected' : '' %>>Admin</option></select><button class="icon-button" type="submit" title="Save site role"><i data-lucide="save"></i></button></form></td>
      <td><form method="post" action="/admin/users/<%= customer.id %>/editor"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="enabled" value="<%= customer.can_edit ? 'false' : 'true' %>"><button class="button button-small <%= customer.can_edit ? 'button-danger' : 'button-quiet' %>" type="submit"><i data-lucide="<%= customer.can_edit ? 'shield-off' : 'shield-check' %>"></i><%= customer.can_edit ? 'Revoke editor' : 'Make editor' %></button></form></td>
      <td><form method="post" action="/admin/users/<%= customer.id %>/sessions/revoke" onsubmit="return confirm('Sign this user out of every Mortal Nexus desktop session?');"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="icon-button" type="submit" title="Revoke all desktop sessions" <%= customer.active_sessions ? '' : 'disabled' %>><i data-lucide="log-out"></i></button></form></td>
    </tr><% }) %>
  </tbody></table></div></section>

  <section class="admin-section" id="licenses"><div class="section-heading mini-heading"><div><span class="eyebrow">Key ownership</span><h2>Licenses</h2><p>Keys are identified by their final characters. Full keys remain encrypted.</p></div></div><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Key</th><th>Owner</th><th>Source</th><th>App use</th><th>Claimed</th></tr></thead><tbody>
    <% licenses.forEach((license) => { %><tr><td><code>••••-<%= license.key_hint %></code></td><td><strong><%= license.display_name || 'Unassigned' %></strong><small><%= license.email || '' %></small></td><td><%= license.payment_provider ? (license.payment_provider === 'paypal' ? 'PayPal purchase' : 'Stripe purchase') : 'KeyAuth redemption' %></td><td><%= license.active_sessions %> active<small><%= license.last_seen_at ? `Last seen ${new Date(license.last_seen_at).toLocaleString()}` : 'Never opened app' %></small></td><td><%= new Date(license.created_at).toLocaleDateString() %></td></tr><% }) %>
  </tbody></table></div></section>

  <section class="admin-section" id="sessions"><div class="section-heading mini-heading"><div><span class="eyebrow">Desktop access</span><h2>Recent app sessions</h2></div></div><div class="data-table-wrap"><table class="data-table"><thead><tr><th>User</th><th>Device</th><th>Version</th><th>Key</th><th>Last seen</th><th>Status</th></tr></thead><tbody>
    <% appSessions.forEach((session) => { const active = !session.revoked_at && new Date(session.expires_at) > new Date(); %><tr><td><strong><%= session.display_name %></strong><small><%= session.email %></small></td><td><%= session.device_name || 'Windows PC' %></td><td><%= session.app_version || 'Unknown' %></td><td><code>••••-<%= session.key_hint %></code></td><td><%= new Date(session.last_seen_at).toLocaleString() %></td><td><span class="status-pill <%= active ? 'fulfilled' : 'fulfillment_failed' %>"><%= active ? 'Active' : 'Revoked / expired' %></span></td></tr><% }) %>
  </tbody></table></div></section>

  <section class="admin-section" id="orders"><div class="section-heading mini-heading"><div><span class="eyebrow">Billing</span><h2>Orders</h2></div></div><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Customer</th><th>Payment</th><th>Status</th><th>Email</th><th>Total</th><th>Created</th><th></th></tr></thead><tbody>
    <% orders.forEach((order) => { %><tr><td><%= order.customer_email %></td><td><strong><%= order.provider === 'paypal' ? 'PayPal' : 'Stripe' %></strong><small><code><%= String(order.provider_order_id || order.stripe_session_id || '').slice(0, 18) %></code></small></td><td><span class="status-pill <%= order.status %>"><%= order.status.replace('_', ' ') %></span></td><td><span class="status-pill <%= order.license_email_status === 'sent' ? 'fulfilled' : order.license_email_status === 'failed' ? 'fulfillment_failed' : '' %>"><%= order.license_email_status %></span></td><td><%= new Intl.NumberFormat('en-US', { style: 'currency', currency: order.currency.toUpperCase() }).format(order.amount_total / 100) %></td><td><%= new Date(order.created_at).toLocaleString() %></td><td><% if (order.status === 'fulfillment_failed' || order.license_email_status === 'failed') { %><form method="post" action="/admin/orders/<%= order.id %>/retry"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="button button-small button-quiet" type="submit">Retry</button></form><% } %></td></tr><% }) %>
  </tbody></table></div></section>

  <section class="admin-section admin-security-strip" id="activity"><div><span class="eyebrow">Security</span><h2>Administration activity</h2><p>Recent permission and session changes are recorded below.</p></div><form method="post" action="/admin/editors/revoke-all" onsubmit="return confirm('Revoke editing and sign every user out of the desktop app?');"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="button button-danger" type="submit"><i data-lucide="shield-off"></i>Revoke all editors</button></form></section>
  <div class="audit-list"><% auditLog.forEach((entry) => { %><div><strong><%= entry.action.replaceAll('.', ' ') %></strong><span><%= entry.target_email || entry.details || '' %></span><time><%= new Date(entry.created_at).toLocaleString() %></time></div><% }) %></div>
</main>
<%- include('partials/footer') %>
