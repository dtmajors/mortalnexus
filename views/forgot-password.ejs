<%- include('partials/header', { title, bodyClass: 'content-page' }) %>
<section class="narrow-form-page page-width">
  <span class="eyebrow">Account recovery</span><h1>Reset your password.</h1>
  <% if (sent) { %><div class="form-alert success"><i data-lucide="mail-check"></i>If that email has an account, a reset link has been sent.</div><a class="button button-primary" href="/login">Back to sign in</a>
  <% } else { %><p>Enter the email used for your Mortal Nexus account. The reset link expires in one hour.</p><form class="stack-form" method="post" action="/forgot-password"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><label>Email address<input type="email" name="email" autocomplete="email" required></label><button class="button button-primary button-large" type="submit">Send reset link</button></form><% } %>
</section>
<%- include('partials/footer') %>
