NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Railway PostgreSQL supplies this automatically after the database is linked.
DATABASE_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters
LICENSE_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# Stripe one-time purchase.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PRODUCT_PRICE_DISPLAY=$19.99

# KeyAuth Seller API. Seller credentials stay server-side.
KEYAUTH_SELLER_KEY=
KEYAUTH_LICENSE_MASK=MNX-****-****-****-****
KEYAUTH_LICENSE_EXPIRY=9999
KEYAUTH_LICENSE_LEVEL=1

# Discord OAuth. The bot must already be in the Mortal Nexus Discord server.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1082658912123244694

# Entire service-account JSON for Firebase project momap-9cb64, stored as one Railway secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=https://momap-9cb64-default-rtdb.firebaseio.com

# Private GitHub release downloads. Customers receive the file through the authenticated website.
DOWNLOAD_URL=/download/latest
GITHUB_RELEASE_REPO=dtmajors/mortalnexus
GITHUB_RELEASE_TOKEN=
GITHUB_RELEASE_ASSET=MortalNexusSetup.exe

# Customer links and site contact information.
DISCORD_URL=https://discord.gg/MmV7gNV5ZG
SUPPORT_EMAIL=support@mortalnexus.com
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_SECRET=replace-with-a-separate-long-random-secret

# Optional transactional email through Resend.
RESEND_API_KEY=
EMAIL_FROM=Mortal Nexus <noreply@mortalnexus.com>
